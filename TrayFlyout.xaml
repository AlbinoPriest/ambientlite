<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AmbientLite quick controls" Width="374" SizeToContent="Height"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
 Background="Transparent" ShowInTaskbar="False" Topmost="True"
 FontFamily="Segoe UI" Foreground="#F1EDE8" UseLayoutRounding="True">
 <Grid>
 <Border Background="#202328" BorderBrush="#363A41" BorderThickness="1" CornerRadius="22" Padding="18" Margin="7">
  <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000000" Opacity="0.4"/></Border.Effect>
  <StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="#F39485" CornerRadius="7" Width="26" Height="26"><Viewbox Width="19" Height="19"><Canvas Width="24" Height="24"><Path Data="M 3,16 L 3,6 Q 3,3 6,3 L 18,3 Q 21,3 21,6 L 21,16 M 7,8 L 17,8 L 17,15 L 7,15 Z M 10,19 L 14,19" Stroke="#241B1B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Border>
    <TextBlock Grid.Column="1" Text="AmbientLite" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,0,0"/>
    <Button x:Name="QuickClose" Grid.Column="2" Content="×" Width="28" Height="28" Padding="0" FontSize="19" FontWeight="Normal" Background="Transparent" BorderThickness="0" Foreground="#B2B0B0" HorizontalContentAlignment="Center" ToolTip="Close quick controls"/>
   </Grid>
   <Border Background="#292D33" CornerRadius="12" Padding="13" Margin="0,16,0,12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Ellipse x:Name="QuickDot" Width="8" Height="8" Fill="#737780" Margin="0,5,10,0" VerticalAlignment="Top"/>
     <StackPanel Grid.Column="1"><TextBlock x:Name="QuickTitle" Text="Ready when you are" FontFamily="Georgia" FontSize="18" TextWrapping="Wrap"/><TextBlock x:Name="QuickDetail" Text="Your atmosphere, a click away." FontSize="11" Foreground="#B2B0B0" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
    </Grid>
   </Border>
   <Button x:Name="QuickToggle" Content="Start lighting" Height="38" Padding="12,8" HorizontalContentAlignment="Center" Background="#F39485" Foreground="#241B1B" BorderThickness="0"/>
   <TextBlock Text="SET THE MOOD" FontSize="10" Foreground="#B2B0B0" Margin="0,20,0,11"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <RadioButton x:Name="QuickScreen" GroupName="Mode" Content="Screen sync"/>
    <RadioButton x:Name="QuickStatic" Grid.Column="2" GroupName="Mode" Content="Static colour"/>
   </Grid>
   <Grid Margin="0,19,0,0"><TextBlock Text="Brightness" FontSize="12"/><TextBlock x:Name="QuickBrightnessText" Text="100%" FontSize="12" Foreground="#F39485" HorizontalAlignment="Right"/></Grid>
   <Slider x:Name="QuickBrightness" Minimum="0" Maximum="100" Margin="0,10,0,0"/>
   <StackPanel x:Name="QuickColours" Margin="0,17,0,0">
    <Grid><TextBlock Text="A FEW FAVOURITES" FontSize="10" Foreground="#B2B0B0"/><Ellipse x:Name="QuickColourDot" Width="12" Height="12" Fill="#FF4800" HorizontalAlignment="Right"/></Grid>
    <UniformGrid x:Name="QuickSwatches" Columns="4" Rows="2" Margin="-3,9,-3,0"/>
    <TextBlock x:Name="QuickColourName" Text="Custom colour" FontSize="11" Foreground="#B2B0B0" Margin="0,7,0,0"/>
   </StackPanel>
   <StackPanel x:Name="QuickScreenSettings" Margin="0,17,0,0">
    <Grid><TextBlock Text="Warmth" FontSize="12"/><TextBlock x:Name="QuickWarmthText" FontSize="12" Foreground="#F39485" HorizontalAlignment="Right"/></Grid>
    <Slider x:Name="QuickWarmth" Minimum="0" Maximum="100" Margin="0,9,0,14"/>
    <Grid><TextBlock Text="Smoothing" FontSize="12"/><TextBlock x:Name="QuickSmoothingText" FontSize="12" Foreground="#F39485" HorizontalAlignment="Right"/></Grid>
    <Slider x:Name="QuickSmoothing" Minimum="0" Maximum="95" Margin="0,9,0,14"/>
    <Grid><TextBlock Text="Refresh rate" FontSize="12"/><TextBlock x:Name="QuickRateText" FontSize="12" Foreground="#F39485" HorizontalAlignment="Right"/></Grid>
    <Slider x:Name="QuickRate" Minimum="5" Maximum="60" Margin="0,9,0,0"/>
   </StackPanel>
   <Border BorderBrush="#363A41" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,13,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
     <Button x:Name="QuickOpen" Content="Open AmbientLite ↗" FontSize="11" Height="35" Padding="8,7" HorizontalContentAlignment="Center"/>
     <Button x:Name="QuickExit" Grid.Column="2" Content="Exit" FontSize="11" Height="35" Padding="8,7" HorizontalContentAlignment="Center" Background="Transparent" Foreground="#B2B0B0"/>
    </Grid>
   </Border>
  </StackPanel>
 </Border>
 </Grid>
</Window>
