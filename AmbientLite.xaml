<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AmbientLite" Width="1060" Height="760" MinWidth="1000" MinHeight="730" WindowStartupLocation="CenterScreen" Background="#17191C" FontFamily="Segoe UI" Foreground="#F1EDE8" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="CanvasBrush" Color="#17191C"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#202328"/>
  <SolidColorBrush x:Key="RaisedBrush" Color="#292D33"/>
  <SolidColorBrush x:Key="LineBrush" Color="#363A41"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#B2B0B0"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#F39485"/>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Padding" Value="16,10"/>
   <Setter Property="Background" Value="#292D33"/>
   <Setter Property="Foreground" Value="#F1EDE8"/>
   <Setter Property="BorderBrush" Value="#363A41"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value></Setter></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#F39485"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="RadioButton">
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="#F1EDE8"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="RadioButton">
     <Border x:Name="Card" Background="#292D33" BorderBrush="#464B53" BorderThickness="1" CornerRadius="18" Padding="15,12">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border x:Name="Circle" Width="17" Height="17" CornerRadius="9" BorderBrush="#B2B0B0" BorderThickness="1.5" VerticalAlignment="Center" Margin="0,0,12,0">
        <Ellipse x:Name="Mark" Width="7" Height="7" Fill="#F39485" Visibility="Collapsed"/>
       </Border>
       <ContentPresenter Grid.Column="1" ContentSource="Content" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="#393035"/><Setter TargetName="Card" Property="BorderBrush" Value="#F39485"/><Setter TargetName="Circle" Property="BorderBrush" Value="#F39485"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#F39485"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#F39485"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#F1EDE8"/>
   <Setter Property="Background" Value="#292D33"/>
   <Setter Property="Padding" Value="11,8"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="ComboBoxItem">
     <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
      <ContentPresenter/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#393035"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#393035"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#F1EDE8"/>
   <Setter Property="Background" Value="#292D33"/>
   <Setter Property="BorderBrush" Value="#363A41"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="ComboBox">
     <Grid>
      <Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12">
       <Grid>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="11,0,25,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <TextBlock Text="⌄" Foreground="#B2B0B0" FontSize="17" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-5,9,0"/>
       </Grid>
      </Border>
      <ToggleButton Focusable="False" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" StaysOpen="False">
       <Border Background="#292D33" BorderBrush="#363A41" BorderThickness="1" CornerRadius="12" Width="135" Margin="0,3,0,0">
        <ScrollViewer MaxHeight="190" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
       </Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#F39485"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#737780"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Foreground" Value="#F1EDE8"/>
   <Setter Property="Margin" Value="0,6"/>
   <Setter Property="MinHeight" Value="28"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="CheckBox">
     <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="2" CornerRadius="12" Padding="2">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" Background="#292D33"
               BorderBrush="#737780" BorderThickness="1">
        <Path x:Name="Tick" Data="M 3,9 L 7,13 L 15,5" Stroke="#241B1B" StrokeThickness="2.3"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Visibility="Collapsed"/>
       </Border>
       <ContentPresenter ContentSource="Content" RecognizesAccessKey="True"
                         VerticalAlignment="Center" Margin="10,0,0,0"/>
      </StackPanel>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Box" Property="Background" Value="#F39485"/>
       <Setter TargetName="Box" Property="BorderBrush" Value="#F39485"/>
       <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#F39485"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="#F39485"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="FocusRing" Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="10"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="ScrollBar">
     <Grid Background="#202328" Width="10">
      <Track x:Name="PART_Track" IsDirectionReversed="True" Maximum="{TemplateBinding Maximum}"
             Minimum="{TemplateBinding Minimum}" Value="{TemplateBinding Value}"
             ViewportSize="{TemplateBinding ViewportSize}">
       <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
       <Track.Thumb>
        <Thumb>
         <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#737780" CornerRadius="18" Margin="2,0"/></ControlTemplate></Thumb.Template>
        </Thumb>
       </Track.Thumb>
       <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
      </Track>
     </Grid>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
<Style TargetType="TextBox">
 <Setter Property="Background" Value="#292D33"/><Setter Property="Foreground" Value="#F1EDE8"/><Setter Property="CaretBrush" Value="#F39485"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="14"/><Setter Property="BorderBrush" Value="#363A41"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="0"><ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" Focusable="False"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#F39485"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style TargetType="Slider">
 <Setter Property="Height" Value="24"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="TickFrequency" Value="1"/><Setter Property="SmallChange" Value="1"/><Setter Property="LargeChange" Value="5"/><Setter Property="Cursor" Value="Hand"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
  <Border x:Name="FocusRing" BorderThickness="1" BorderBrush="Transparent" CornerRadius="12" Padding="2,0">
   <Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
    <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#F39485" CornerRadius="2" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb Width="14" Height="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse x:Name="Knob" Width="14" Height="14" Fill="#F39485" VerticalAlignment="Center"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Fill" Value="#FFC1B5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#464B53" CornerRadius="2" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
   </Track>
  </Border>
  <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="#F39485"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>

 </Window.Resources>
<Grid Background="#17191C">
 <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#1C1F23" BorderBrush="#363A41" BorderThickness="0,0,1,0">
  <Grid Margin="15,23,15,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
    <TextBlock Text="YOUR ATMOSPHERE" Foreground="#B2B0B0" FontSize="10" Margin="9,0,0,36"/>
    <Button x:Name="LightingNav" Content="Screen sync" HorizontalContentAlignment="Left" Padding="14,12" Background="#292D33" BorderThickness="0" Margin="0,0,0,6"/>
    <Button x:Name="ColourNav" Content="Static colour" HorizontalContentAlignment="Left" Padding="14,12" Background="Transparent" BorderThickness="0" Foreground="#B2B0B0" Margin="0,0,0,6"/>
    <Button x:Name="SetupNav" Content="Strip setup" HorizontalContentAlignment="Left" Padding="14,12" Background="Transparent" BorderThickness="0" Foreground="#B2B0B0"/>
    <Button x:Name="StartupNav" Content="Startup" HorizontalContentAlignment="Left" Padding="14,12" Background="Transparent" BorderThickness="0" Foreground="#B2B0B0" Margin="0,6,0,0"/>
   </StackPanel>
   <StackPanel Grid.Row="2">
    <Border BorderBrush="#363A41" BorderThickness="0,1,0,0" Padding="8,18,4,0">
     <StackPanel><TextBlock Text="A LITTLE MORE IMMERSIVE" FontSize="9" Foreground="#B2B0B0"/>
      <TextBlock Text="Your screen. Your space.&#10;A softer connection." FontSize="11" Foreground="#B2B0B0" LineHeight="18" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </Grid>
 </Border>
 <Grid Grid.Column="1" Margin="32,23,30,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <Grid>
   <StackPanel Orientation="Horizontal">
    <Border Width="28" Height="28" CornerRadius="8" Background="#F39485" Margin="0,0,10,0"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M 3,16 L 3,6 Q 3,3 6,3 L 18,3 Q 21,3 21,6 L 21,16 M 7,8 L 17,8 L 17,15 L 7,15 Z M 10,19 L 14,19" Stroke="#241B1B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Border>
    <TextBlock Text="AmbientLite" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"/>
   </StackPanel>

    <Button x:Name="QuickControlsButton" Content="Quick controls ↗" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="11" Padding="10,6" Background="Transparent" BorderThickness="0" Foreground="#B2B0B0" ToolTip="Open the same quick controls available from the tray"/>
   </Grid>   <TextBlock x:Name="PageTitle" Text="A little beyond the screen." FontFamily="Georgia" FontSize="34" Margin="0,24,0,0"/>
   <TextBlock x:Name="PageSubtitle" Text="Colour that follows the moment." FontSize="12" Foreground="#B2B0B0" Margin="0,7,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Background="#202328" CornerRadius="18" Padding="20,18" Margin="0,25,0,24">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#737780" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock x:Name="StateTitle" Text="Ready when you are" FontSize="15" FontWeight="Medium"/></StackPanel>
     <TextBlock x:Name="StateDetail" Text="Choose your screen and let the colour flow." FontSize="11" Foreground="#B2B0B0" Margin="18,6,14,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Button x:Name="SyncButton" Grid.Column="1" Content="Start lighting" Background="#F39485" Foreground="#241B1B" BorderThickness="0" MinWidth="143" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2" x:Name="LightingPage">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,12"><TextBlock Text="THE BIG PICTURE" FontSize="10" Foreground="#B2B0B0"/><TextBlock x:Name="LayoutSummary" Text="71 lights · three sides" HorizontalAlignment="Right" FontSize="11" Foreground="#B2B0B0"/></Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="254"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,24,0">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="#202328" CornerRadius="18" MinHeight="205" Margin="0,0,0,18">
      <Grid Margin="20,12">
       <Viewbox MaxWidth="340" MaxHeight="205" Margin="0,0,0,18">
        <Canvas Width="340" Height="205">
         <Path Data="M 25,158 L 25,30 Q 25,18 38,18 L 302,18 Q 315,18 315,30 L 315,158" StrokeThickness="30" Opacity="0.07" Stroke="#F39485" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
         <Path Data="M 25,158 L 25,30 Q 25,18 38,18 L 302,18 Q 315,18 315,30 L 315,158" StrokeThickness="12" Opacity="0.12" Stroke="#F39485" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
         <Path Data="M 25,158 L 25,30 Q 25,18 38,18 L 302,18 Q 315,18 315,30 L 315,158" StrokeThickness="4" Stroke="#F39485" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
         <Rectangle Canvas.Left="38" Canvas.Top="30" Width="264" Height="137" RadiusX="9" RadiusY="9" Stroke="#55565C" StrokeThickness="2" Fill="#17191C"/>
         <Rectangle Canvas.Left="45" Canvas.Top="37" Width="250" Height="122" RadiusX="4" RadiusY="4"><Rectangle.Fill><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#33303B" Offset="0"/><GradientStop Color="#58424B" Offset="0.5"/><GradientStop Color="#B37B70" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
         <Path Data="M 154,168 L 154,185 L 186,185 L 186,168 M 135,187 L 205,187" Stroke="#55565C" StrokeThickness="2"/>
        </Canvas>
       </Viewbox>
       <TextBlock Text="SCREEN → LIGHT → ROOM" Foreground="#B2B0B0" FontSize="9" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2"/>
      </Grid>
     </Border>
     <TextBlock Grid.Row="1" Text="Follow this screen" FontSize="12" Margin="0,0,0,8"/>
     <ComboBox x:Name="Monitor" Grid.Row="2" Height="40" FontSize="12"/>
    </Grid>
    <StackPanel Grid.Column="1">
     <Border Background="#202328" CornerRadius="18" Padding="18,17">
      <StackPanel>
       <TextBlock Text="SET THE FEELING" FontSize="10" Foreground="#B2B0B0" Margin="0,0,0,12"/>
       <Grid><TextBlock Text="Brightness" FontSize="13"/><TextBlock x:Name="BrightnessValue" Text="70%" HorizontalAlignment="Right" Foreground="#F39485" FontSize="12"/></Grid>
       <Slider x:Name="Brightness" Minimum="0" Maximum="100" Value="70" Margin="0,6,0,2"/>
       <TextBlock Text="A glow, or a little more." FontSize="11" Foreground="#B2B0B0" Margin="0,0,0,10"/>
       <Grid><TextBlock Text="Warmth" FontSize="13"/><TextBlock x:Name="WarmthValue" Text="Neutral" HorizontalAlignment="Right" Foreground="#F39485" FontSize="12"/></Grid>
       <Slider x:Name="Warmth" Minimum="0" Maximum="100" Value="0" Margin="0,6,0,2" AutomationProperties.Name="Screen colour warmth"/>
       <TextBlock Text="Less blue. A warmer screen glow." FontSize="11" Foreground="#B2B0B0" Margin="0,0,0,10"/>
       <Grid><TextBlock Text="Smoothing" FontSize="13"/><TextBlock x:Name="SmoothingValue" Text="45%" HorizontalAlignment="Right" Foreground="#F39485" FontSize="12"/></Grid>
       <Slider x:Name="Smoothing" Minimum="0" Maximum="95" Value="45" Margin="0,6,0,2"/>
       <TextBlock Text="Higher means gentler transitions." FontSize="11" Foreground="#B2B0B0" Margin="0,0,0,10"/>
       <Grid><TextBlock Text="Refresh rate" FontSize="13"/><TextBlock x:Name="RateValue" Text="20 fps" HorizontalAlignment="Right" Foreground="#F39485" FontSize="12"/></Grid>
       <Slider x:Name="Rate" Minimum="5" Maximum="60" Value="20" Margin="0,6,0,2"/>
       <TextBlock Text="20 fps is a good everyday balance." FontSize="11" Foreground="#B2B0B0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </Grid>
  </Grid>
<Grid Grid.Row="2" x:Name="ColourPage" Visibility="Collapsed">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,12"><TextBlock Text="ONE COLOUR. YOUR MOOD." Foreground="#B2B0B0" FontSize="10"/><TextBlock Text="No screen capture" HorizontalAlignment="Right" Foreground="#B2B0B0" FontSize="11"/></Grid>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
  <Border Background="#202328" CornerRadius="18" Margin="0,0,24,0" Padding="18,12">
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="WheelHost" Width="270" Height="270" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,6,0,6"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse x:Name="ChosenDot" Width="14" Height="14" Fill="#FFC885" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock x:Name="ChosenName" Text="Candle" FontFamily="Georgia" FontSize="21"/></StackPanel><TextBlock x:Name="ChosenHex" Text="#FFC885" FontSize="11" Foreground="#B2B0B0" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Border Grid.Column="1" Background="#202328" CornerRadius="18" Padding="18,17">
   <StackPanel><TextBlock Text="A FEW FAVOURITES" Foreground="#B2B0B0" FontSize="10" Margin="0,0,0,14"/>
    <UniformGrid x:Name="Swatches" Columns="2" Rows="4" Margin="-3,0,-3,17"/>
    <Border BorderBrush="#363A41" BorderThickness="0,1,0,0" Padding="0,17,0,0"><StackPanel><Grid><TextBlock Text="Brightness" FontSize="13"/><TextBlock Text="{Binding ElementName=BrightnessValue, Path=Text}" Foreground="#F39485" FontSize="12" HorizontalAlignment="Right"/></Grid><Slider x:Name="StaticBrightness" Minimum="0" Maximum="100" Value="{Binding ElementName=Brightness, Path=Value, Mode=TwoWay}" Margin="0,12,0,4"/><TextBlock Text="Pick a colour. Settle into it." Foreground="#B2B0B0" FontSize="11"/></StackPanel></Border>
   </StackPanel>
  </Border>
 </Grid>
</Grid>
  <Grid Grid.Row="2" x:Name="SetupPage" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="MAKE THE CONNECTION" FontSize="10" Foreground="#B2B0B0" Margin="0,0,0,12"/>
   <Border Grid.Row="1" Background="#202328" CornerRadius="18" Padding="20">
    <StackPanel><TextBlock Text="Around your screen." FontFamily="Georgia" FontSize="23"/><TextBlock Text="A three-sided strip, with the same number of lights on each side." Foreground="#B2B0B0" FontSize="12" Margin="0,8,0,16"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,20,0"><TextBlock Text="Across the top" FontSize="12" Margin="0,0,0,8"/><TextBox x:Name="TopCount" Text="41" Height="40"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="On each side" FontSize="12" Margin="0,0,0,8"/><TextBox x:Name="SideCount" Text="15" Height="40"/></StackPanel>
     </Grid>
     <CheckBox x:Name="Reverse" Content="Cable starts at bottom-right" IsChecked="True" Margin="0,14,0,6"/>
     <TextBlock Text="Viewed from the front. Uncheck for bottom-left." FontSize="11" Foreground="#B2B0B0" Margin="30,0,0,0"/>
     <TextBlock x:Name="SetupHelp" Text="Pause lighting before changing the strip layout." FontSize="11" Foreground="#B2B0B0" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
   <Border Grid.Row="2" BorderBrush="#363A41" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,0">
    <Grid><StackPanel><TextBlock Text="Everything connected?" FontSize="14"/><TextBlock Text="Send a soft blue to every light to check your strip." FontSize="11" Foreground="#B2B0B0" Margin="0,6,0,0"/></StackPanel><Button x:Name="TestButton" Content="Test lights" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Center"/></Grid>
   </Border>
   <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox x:Name="CompatibilityCapture" Content="Compatibility capture"/><TextBlock Grid.Column="1" Text="Only if smooth capture doesn't work. May cause desktop hitches." Foreground="#B2B0B0" FontSize="11" TextWrapping="Wrap" Margin="18,0,0,0" VerticalAlignment="Center"/></Grid>
  </Grid>
  <Grid Grid.Row="2" x:Name="StartupPage" Visibility="Collapsed">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel>
    <TextBlock Text="MAKE YOURSELF AT HOME" FontSize="10" Foreground="#B2B0B0" Margin="0,0,0,12"/>
    <Border Background="#202328" CornerRadius="18" Padding="22,18">
     <StackPanel>
      <TextBlock Text="An easy beginning." FontFamily="Georgia" FontSize="23" Margin="0,0,0,8"/>
      <CheckBox x:Name="StartWithWindows" Content="Start with Windows"/>
      <TextBlock Text="Open AmbientLite when you sign in to this Windows account." FontSize="11" Foreground="#B2B0B0" Margin="34,0,0,10" TextWrapping="Wrap"/>
      <Border BorderBrush="#363A41" BorderThickness="0,1,0,0" Padding="0,8,0,0">
       <StackPanel>
        <CheckBox x:Name="TrayAtStartup" Content="Keep the window in the tray"/>
        <TextBlock Text="A quiet start. Double-click the tray icon to open the app." FontSize="11" Foreground="#B2B0B0" Margin="34,0,0,8" TextWrapping="Wrap"/>
        <CheckBox x:Name="LightingAtStartup" Content="Start lighting at sign-in"/>
        <TextBlock Text="Use your saved mode, colour, brightness, and screen settings." FontSize="11" Foreground="#B2B0B0" Margin="34,0,0,0" TextWrapping="Wrap"/>
        <CheckBox x:Name="OffAtExit" Content="Turn lights off on shutdown and exit" Margin="0,12,0,6"/>
        <TextBlock Text="Send black before the app closes. Closing this window still keeps lighting in the tray." FontSize="11" Foreground="#B2B0B0" Margin="34,0,0,0" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Border>
    <TextBlock x:Name="StartupStatus" Text="Tray and lighting choices apply when Windows starts the app." FontSize="12" Foreground="#F39485" TextWrapping="Wrap" Margin="4,10,4,0"/>
    <TextBlock x:Name="StorageDetail" Text="Your preferences stay with you through updates." FontSize="11" Foreground="#B2B0B0" TextWrapping="Wrap" Margin="4,6,4,0"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <Grid Grid.Row="3" Margin="0,22,0,0"><TextBlock Text="Closing this window keeps lighting in the tray." FontSize="10" Foreground="#85878C"/><TextBlock x:Name="RunStats" Text="Local. Quiet. Yours." HorizontalAlignment="Right" FontSize="10" Foreground="#85878C"/></Grid>
 </Grid>
</Grid>

</Window>
